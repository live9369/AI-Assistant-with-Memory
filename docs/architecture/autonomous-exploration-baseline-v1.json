    {
      "id": "M01",
      "name": "自主问题率",
      "definition": "独立标注为“从经历产生且未由用户直接指定”的首次入库问题数 / 全部首次入库问题数",
      "unit": "ratio",
      "sources": "E+T+L；internal来源可自动筛选，语义自主性需独立标注；仅内部标签不够",
      "availability": "external_annotations",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
      "id": "M02",
      "name": "可验证问题率",
      "definition": "能明确对象、可取得的观察、区分至少两种结果的判定条件的问题数 / 全部首次入库问题数",
      "unit": "ratio",
      "sources": "E+L；verification字段非空只是格式检查",
      "availability": "external_annotations",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
      "id": "M03",
      "name": "引用接纳完整率",
      "definition": "所有被接受结果中，在该请求allowed_evidence_refs内且能定位原始来源的引用出现次数 / 被接受结果中的全部引用出现次数",
      "unit": "ratio",
      "sources": "E+T；现有记录可计算，按出现次数；零引用不能算100%",
      "availability": "existing_records_aggregation_required",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
      "id": "M04",
      "name": "有效探索率",
      "definition": "独立检查认为新增观察确实区分候选解释或消除预先标注不确定性的调查活动数 / 全部调查活动数",
      "unit": "ratio",
      "sources": "E+A+L；失败和无效读取留在分母；报告可解／不可解分层",
      "availability": "external_annotations",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
      "id": "M05",
      "name": "证据响应率",
      "definition": "获得预标注有效反例后，在剩余额度内正确撤回或修正原判断的机会数 / 全部有效反例机会数",
      "unit": "ratio",
      "sources": "T+A+L+H；一次question×一次预注册反例为机会；未主动获取反例也记失败，另报“已获取”条件率",
      "availability": "external_annotations_and_harness",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
      "id": "M06",
      "name": "错误结束率",
      "definition": "独立判定缺证、矛盾或结论错误的首次resolved问题数 / 全部首次resolved问题数",
      "unit": "ratio",
      "sources": "E+T+A+L；未resolved不进入分母，但必须同时报告M07防止全不结束",
      "availability": "external_annotations",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
      "id": "M07",
      "name": "正确解决覆盖率",
      "definition": "在预算内独立核验为正确解决的预标注可解知识缺口数 / 该case预标注可解缺口数",
      "unit": "ratio",
      "sources": "L+E+A；系统不提问或始终休眠也不能规避分母",
      "availability": "external_annotations",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
      "id": "M08",
      "name": "语义重复探索率",
      "definition": "未引入新证据、新条件或新验证方法，却重复同一语义问题与观察操作的调查活动数 / 全部调查活动数",
      "unit": "ratio",
      "sources": "E+A+L；文本ID去重不等于该指标为0",
      "availability": "external_annotations",
      "gate": "G2",
      "current_status": "not_run",
      "value": null
    },
    {
